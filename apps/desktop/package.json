{
  "name": "@free-new-desk/desktop",
  "version": "1.4.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "dev": "vite"
  },
  "dependencies": {
    "@free-new-desk/contracts": "0.1.0",
    "@free-new-desk/data-service": "0.1.0",
    "@free-new-desk/source-engine": "1.3.0",
    "@free-new-desk/source-sdk": "0.1.0",
    "@free-new-desk/tvbox-config": "0.2.0",
    "@free-new-desk/live-parser": "0.2.0",
    "@free-new-desk/epg-parser": "0.2.0",
    "@free-new-desk/proxy-service": "0.3.0",
    "pinia": "3.0.3",
    "vue": "3.5.20",
    "vue-router": "4.5.1",
    "zod": "3.25.76"
  }
}
